{
  "name": "nexus-unified-v4.9",
  "version": "4.9.0",
  "description": "Nexus Unificado v4.9 - Maestro + DeepSite + Visão Python",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "NODE_ENV=development nodemon src/app.js",
    "lint": "echo 'Linter não configurado.'",
    "test": "echo \"Nenhum teste configurado.\" && exit 0",
    "setup:vision": "cd vision && python3 -m venv .venv && source .venv/bin/activate && pip install --upgrade pip && pip install -r requirements.txt && deactivate && echo 'Ambiente Python e dependências criados em ./vision/.venv. Atualize VISION_PYTHON_PATH no .env se necessário.'",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down"
  },
  "keywords": [
    "ai", "llm", "gemini", "agent", "automation", "vision", "deepsite", "nodejs", "socket.io", "bullmq", "robotjs"
  ],
  "author": "Nexus Team",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.11.1",
    "@socket.io/redis-adapter": "^8.2.1",
    "axios": "^1.6.8",
    "bullmq": "^5.7.7",
    "dotenv": "^16.4.5",
    "dockerode": "^4.0.2",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jimp": "^0.22.12",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "robotjs": "^0.6.0",
    "screenshot-desktop": "^1.15.0",
    "socket.io": "^4.7.5",
    "sqlite3": "^5.1.7",
    "tesseract.js": "^5.0.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
